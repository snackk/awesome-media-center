# Optional overrides. Every variable has a default in the compose files.
# Use it with: for d in traefik portainer emby arr transmission debrid jenkins; do ln -sf ../.env "$d/.env"; done

# Root of the MergerFS pool (media + downloads share ONE filesystem for hardlinks)
DATA_ROOT=/mnt/pool
# Application configuration (can live on an SSD/NVMe)
CONFIG_ROOT=/mnt/pool/config

PUID=1000
PGID=1000
TZ=Europe/Lisbon

DOMAIN=snackk-media.com

# Host GIDs for hardware transcoding (getent group render video)
RENDER_GID=992
VIDEO_GID=44

