# Optional overrides. Every variable has a default in the compose files.
# Use it with: for d in traefik portainer emby arr transmission debrid immich navidrome homecontrol; do ln -sf ../.env "$d/.env"; done

# Root of the MergerFS pool (media + downloads share ONE filesystem for hardlinks)
DATA_ROOT=/mnt/pool
# Application configuration (can live on an SSD/NVMe)
CONFIG_ROOT=/mnt/pool/config

PUID=1000
PGID=1000
TZ=Europe/Lisbon

DOMAIN=snackk-media.com

# Host GIDs for hardware transcoding (getent group render video)
RENDER_GID=992
VIDEO_GID=44


# Immich (letters and digits only)
IMMICH_DB_PASSWORD=change-me
# Pin a version for predictable upgrades, e.g. v2.0.0
IMMICH_VERSION=release

# HomeControl (required by homecontrol/)
HC_USERNAME=change-me
HC_PASSWORD=change-me
HC_API_KEY=change-me
# NETATMO_CLIENT_ID=
# NETATMO_CLIENT_SECRET=
# NETATMO_ACCESS_TOKEN=
# Private SSH key mounted read-only into homecontrol
SSH_KEY_PATH=/mnt/pool/config/homecontrol/ssh/id_rsa
