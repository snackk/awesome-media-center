# Copy to .env and fill in. There are NO defaults in the compose files:
# every variable below must be defined, otherwise `docker compose` fails with a clear error.
# Variables marked "may be empty" must still exist (leave the value blank).
# Make the file available to every stack:
#   for d in traefik portainer emby arr transmission debrid immich navidrome homecontrol tailscale; do ln -sf ../.env "$d/.env"; done

# ── Storage ──────────────────────────────────────────────────────────────────
# Root of the MergerFS pool (media + downloads share ONE filesystem for hardlinks)
DATA_ROOT=/mnt/pool
# Application configuration (can live on an SSD/NVMe)
CONFIG_ROOT=/mnt/pool/config

# ── Common ───────────────────────────────────────────────────────────────────
# User/group that owns the files (id -u / id -g)
PUID=1000
PGID=1000
TZ=Europe/Lisbon
# Base domain: services are published as <name>.DOMAIN
DOMAIN=snackk-media.com

# ── Emby hardware transcoding ────────────────────────────────────────────────
# Host GIDs (getent group render video). On Ubuntu 24.04 render is often 993
RENDER_GID=993
VIDEO_GID=44

# ── Immich ───────────────────────────────────────────────────────────────────
# Letters and digits only
IMMICH_DB_PASSWORD=change-me
# Pin a version for predictable upgrades, e.g. v2.0.0
IMMICH_VERSION=release

# ── HomeControl ──────────────────────────────────────────────────────────────
HC_USERNAME=change-me
HC_PASSWORD=change-me
HC_API_KEY=change-me
# Netatmo OAuth2 (may be empty)
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_ACCESS_TOKEN=
# Private SSH key mounted read-only into homecontrol
SSH_KEY_PATH=/mnt/pool/config/homecontrol/ssh/id_rsa

# ── Tailscale ────────────────────────────────────────────────────────────────
# Auth key, only needed on first start (may be empty afterwards):
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=ugreen-nas
# LAN subnet advertised to the tailnet (subnet router)
TS_ROUTES=192.168.1.0/24
# Extra flags, e.g. --advertise-exit-node (may be empty)
TS_EXTRA_ARGS=

